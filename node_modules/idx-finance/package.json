{
  "name": "idx-finance",
  "version": "1.0.0",
  "description": "TypeScript library + CLI for Indonesian Stock Exchange (IDX) data",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "idx": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "idx",
    "indonesia",
    "stock",
    "finance",
    "ihsg",
    "bursa",
    "saham"
  ],
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^13.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sulthonzh/idx-finance.git"
  },
  "homepage": "https://github.com/sulthonzh/idx-finance#readme",
  "bugs": {
    "url": "https://github.com/sulthonzh/idx-finance/issues"
  },
  "author": "Sulthon",
  "publishConfig": {
    "access": "public"
  }
}
